# Real, pullable images a fault injector swaps in, not fake tags like
# inject_app.py's "app-image:latest" or inject_operator.py's
# "pingcap/tidb-operatorr:v1.6.3" (typo in "operatorr"), which must never be
# seeded: the whole point of those two is that they resolve nowhere.
docker.io/jackcuii/kube-proxy:v1.31.12
docker.io/jackcuii/hotel-reservation:latest
docker.io/yinfangchen/geo:app3
# Also the TiDB Operator Helm chart's real operatorImage
# (SREGym-applications/FleetCast/tidb-operator/values.yaml overrides the
# chart default v1.6.0 to this same v1.6.3), so this one line covers both
# inject_operator.py's fault-recovery target and tidb_cluster_operator.py's
# real `helm install` of the operator and its per-cluster discovery
# Deployment (which shares the operator's own image).
docker.io/pingcap/tidb-operator:v1.6.3
# pd/tikv/tidb images a TidbCluster CR renders once tidb-operator defaults
# its unset baseImage fields (pingcap/pd, pingcap/tikv, pingcap/tidb) and
# applies spec.version: confirmed from tidb-operator v1.6.0's own source
# (pkg/apis/pingcap/v1alpha1/defaulting/tidbcluster.go) against
# SREGym-applications/FleetCast/tidb-operator/tidb-cluster.yaml's
# "version: v8.1.0" with no baseImage overrides of its own. tidb_cluster_
# operator.py's own mysql-client probe pod is the fourth: a plain,
# off-the-shelf image, not operator-rendered.
docker.io/pingcap/pd:v8.1.0
docker.io/pingcap/tikv:v8.1.0
docker.io/pingcap/tidb:v8.1.0
docker.io/library/mysql:8
docker.io/calico/cni:v3.27.0
docker.io/calico/kube-controllers:v3.27.0
docker.io/calico/node:v3.27.0
docker.io/openebs/node-disk-exporter:2.1.0
docker.io/openebs/node-disk-manager:2.1.0
docker.io/openebs/node-disk-operator:2.1.0
docker.io/openebs/provisioner-localpv:3.4.0
# The vendored OpenEBS operator manifest's own OPENEBS_IO_HELPER_IMAGE and
# CLEANUP_JOB_IMAGE env values (sregym/resources/vendored/openebs-operator-
# v3.5.0.yaml): every PVC provisioned by openebs-hostpath runs a pod with
# this image, so without it in the cache no PVC using that StorageClass
# (Loki's, Prometheus's) ever binds.
docker.io/openebs/linux-utils:3.5.0
docker.io/nofireai/edge:v3.6.0

