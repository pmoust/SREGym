#!/usr/bin/env bash
# SREGym benchmark shard bootstrap. Rendered by terraform/compute.tf.
#
# Lifecycle: install -> pull prior results -> run this shard with --resume ->
# sync after every problem -> terminate.
#
# Terminating is the normal exit, not the error path. A forgotten r7a.24xlarge
# costs about $7.30/hr on demand, so the instance kills itself when its shard is
# done and again when max_runtime_hours elapses, whichever comes first.

set -uo pipefail
exec > >(tee -a /var/log/sregym-bootstrap.log) 2>&1

RUN_ID="${run_id}"
SHARD_INDEX="${shard_index}"
SHARD_COUNT="${shard_count}"
REGION="${region}"
BUCKET="${bucket}"
S3_PREFIX="s3://${bucket}/${run_id}/shard-${shard_index}"

# Keyed by instance, not by shard. A spot replacement boots as the same shard
# and would otherwise overwrite the original's manifest under one fixed name,
# losing the record of what the original actually ran -- which can differ, since
# brain_go_ref resolves to a SHA at boot and the replacement boots later.
IMDS_TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token \
  -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' || true)
INSTANCE_ID=$(curl -sf -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" \
  http://169.254.169.254/latest/meta-data/instance-id || echo unknown)
MANIFEST="/var/log/sregym-run-manifest-$INSTANCE_ID.txt"
WORKDIR=/opt/sregym
# Each slot writes its own results tree at slots/<slot>/results (main.py
# resolves "results" relative to the slot's own working directory -- see the
# slot-workers section below). Syncing the whole slots/ tree in one call is
# simpler and correct where a per-slot sync would just be this in a loop:
# S3 sync only transfers what changed, so one call covers every slot's
# progress without knowing how many there are.
SLOTS_DIR="$WORKDIR/slots"

echo "[bootstrap] run=$RUN_ID shard=$SHARD_INDEX/$SHARD_COUNT region=$REGION"
echo "[bootstrap] results -> $S3_PREFIX"

IID=$(curl -sf -H "X-aws-ec2-metadata-token: $(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')" \
      http://169.254.169.254/latest/meta-data/instance-id)
echo "[bootstrap] instance=$IID"

terminate() {
  local reason="$1"
  echo "[bootstrap] terminating: $reason"
  sync_results || true
  sync_logs || true
  %{ if keep_alive_on_failure }
  echo "[bootstrap] keep_alive_on_failure is set, staying up. hard_stop still terminates at the runtime cap."
  %{ else }
  aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || shutdown -h now
  %{ endif }
}

# Unconditional kill, used only by the runtime cap below. keep_alive_on_failure
# deliberately does not apply here: the cap exists so a wedged or forgotten run
# cannot bill indefinitely, and a debug flag that silently disables the one
# backstop against that defeats its purpose. Every other exit goes through
# terminate() above, which the flag does suppress.
hard_stop() {
  echo "[bootstrap] $1"
  sync_results || true
  sync_logs || true
  aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || shutdown -h now
}

sync_results() {
  [ -d "$SLOTS_DIR" ] || return 0
  aws s3 sync "$SLOTS_DIR" "$S3_PREFIX/slots/" --region "$REGION" --only-show-errors
}

# The bootstrap log and the per-slot logs live in /var/log, outside SLOTS_DIR,
# so sync_results never carried them. Without this a self-terminating failure
# takes the only record of why it failed down with the instance, which leaves
# keep_alive_on_failure as the only way to debug one and that bills per hour
# until someone remembers to kill the box.
sync_logs() {
  # Token counters first, so the file shipped below is current. brain-go
  # exposes llm_tokens_total labelled by thread_id, which the driver sets per
  # problem, and nothing else captures it: the first two full runs produced no
  # token figure at all and cannot be priced. Counters are cumulative, so the
  # last scrape before termination is the one that matters.
  if [ -x "$WORKDIR/scripts/benchmark/scrape_tokens.sh" ]; then
    "$WORKDIR/scripts/benchmark/scrape_tokens.sh" /var/log/sregym-tokens.prom || true
  fi

  # sregym-pf-*.log is the port-forward's own stderr. Without it a forward
  # that died leaves no trace off the box, which is how run-20260831-1752 had
  # to be diagnosed from tool-call timings instead of from the cause.
  for f in /var/log/sregym-bootstrap.log /var/log/sregym-slot-*.log \
           /var/log/sregym-pf-*.log /var/log/sregym-tokens.prom "$MANIFEST"; do
    [ -f "$f" ] || continue
    aws s3 cp "$f" "$S3_PREFIX/logs/$(basename "$f")" \
      --region "$REGION" --only-show-errors || true
  done
}

# --- hard runtime cap -------------------------------------------------------
# Backstop against a wedged run. The normal exit is shard completion below.
( sleep $(( ${max_runtime_hours} * 3600 )) && hard_stop "max_runtime_hours=${max_runtime_hours} elapsed" ) &

# --- spot interruption ------------------------------------------------------
# EC2 gives two minutes' notice on IMDS. With per-problem syncing this is belt
# and braces, but it costs ten lines and saves the in-flight problem's partial
# artifacts.
(
  while true; do
    TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' || true)
    if [ -n "$TOKEN" ] && curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
         http://169.254.169.254/latest/meta-data/spot/instance-action >/dev/null 2>&1; then
      echo "[spot] interruption notice received, syncing before we lose the box"
      sync_results || true
      sync_logs || true
      exit 0
    fi
    sleep 5
  done
) &

# --- host prerequisites -----------------------------------------------------
# kind nodes share the host's inotify limits, and the defaults are low enough
# that system pods die with "too many open files" once several clusters are up.
cat >/etc/sysctl.d/99-sregym.conf <<'SYSCTL'
fs.inotify.max_user_instances=1024
fs.inotify.max_user_watches=1048576
fs.file-max=2097152
SYSCTL
sysctl --system

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
# openssh-client is listed explicitly for ssh-agent, not for ssh. The brain-go
# image build needs a keyless agent running before compose will resolve its
# build config at all (see the brain-go section below). Ubuntu's server image
# ships it, but naming it here means a base-image change cannot quietly remove
# the one binary that gates the build.
apt-get install -y ca-certificates curl gnupg git jq unzip make openssh-client

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  >/etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

curl -fsSL -o /usr/local/bin/kind https://kind.sigs.k8s.io/dl/latest/kind-linux-amd64
chmod +x /usr/local/bin/kind
curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
chmod +x /usr/local/bin/kubectl
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --update

# --- the harness ------------------------------------------------------------
GH_TOKEN=$(aws ssm get-parameter --region "$REGION" --name "${github_token_ssm_path}" --with-decryption --query 'Parameter.Value' --output text)
if [ -z "$GH_TOKEN" ] || [ "$GH_TOKEN" = "None" ]; then
  terminate "could not read the clone token from ${github_token_ssm_path}"
  exit 1
fi

git clone --recurse-submodules "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/sregym.git" "$WORKDIR"
cd "$WORKDIR"
git checkout "${sregym_ref}"
uv sync

# --- brain-go ---------------------------------------------------------------
# BRAIN_API_URL defaults to localhost:8001, so brain-go runs here beside the
# harness. Standing it up, seeding the account and the four CUSTOM_MCP rows, and
# minting the CLI key is NOFireAI/brain-go#2219's job. Until that lands this
# shard cannot run, so fail loudly rather than burning an hour looking healthy.
if [ ! -x "$WORKDIR/scripts/benchmark/setup_brain_go.sh" ]; then
  echo "[bootstrap] scripts/benchmark/setup_brain_go.sh is missing on ref ${sregym_ref}."
  terminate "brain-go setup script not present"
  exit 1
fi

# brain-go runs on this box beside the harness, so it has to be checked out
# here. setup_brain_go.sh brings up its compose stack and seeds it.
# Fetch-then-checkout, not `clone --branch`. --branch takes a branch or a tag
# and nothing else, so a commit SHA fails the clone outright:
#
#   warning: Could not find remote branch 142a8e5c... to clone.
#   fatal: Remote branch 142a8e5c... not found in upstream origin
#
# which terminated all three instances of run-20260831-1729 about eighty
# seconds in. A SHA is what makes a benchmark run reproducible: brain-go moved
# nineteen commits in the two days before that run, four of them in the RCI
# path, so a run against a branch name cannot tell a real change from an
# intervening merge, and three shards launching minutes apart can pick up
# different code.
#
# This form takes either. GitHub serves a fetch for an arbitrary commit, so the
# depth-1 shallow fetch is kept for both cases; sregym above already uses
# clone-then-checkout and has never had the limitation.
# Built in a temp directory and moved into place, so the checkout either exists
# complete or does not exist. `git clone` deleted its target on failure and was
# therefore safe to re-run; init-then-fetch would leave a directory holding a
# .git and nothing else, and the [ ! -d ] guard below would then skip it on
# every later attempt, so the run would fail somewhere further on with a message
# about brain-go's own setup rather than about an empty checkout. Only the
# keep_alive_on_failure debug flow re-runs this, which is the flow that flag
# exists for.
BRAIN_GO_DIR=/opt/brain-go
if [ ! -d "$BRAIN_GO_DIR" ]; then
  BRAIN_GO_TMP="$BRAIN_GO_DIR.partial.$$"
  rm -rf "$BRAIN_GO_TMP"
  brain_go_failed() {
    rm -rf "$BRAIN_GO_TMP"
    terminate "$1"
    exit 1
  }

  git init "$BRAIN_GO_TMP" >/dev/null \
    || brain_go_failed "could not init the brain-go checkout"
  git -C "$BRAIN_GO_TMP" remote add origin \
    "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/brain-go.git" \
    || brain_go_failed "could not set the brain-go remote"
  # A full 40-hex ref fetches as an object; a branch or tag fetches by name.
  # Both leave the commit at FETCH_HEAD. An abbreviated SHA resolves as neither
  # and is rejected at plan by brain_go_ref's validation.
  git -C "$BRAIN_GO_TMP" fetch --depth 1 origin "${brain_go_ref}" \
    || brain_go_failed "could not fetch brain-go ref ${brain_go_ref}"
  git -C "$BRAIN_GO_TMP" checkout --detach FETCH_HEAD \
    || brain_go_failed "could not check out brain-go ref ${brain_go_ref}"

  mv "$BRAIN_GO_TMP" "$BRAIN_GO_DIR" \
    || brain_go_failed "could not move the brain-go checkout into place"
fi

# Recorded so the results say which build produced them, rather than leaving it
# to be inferred from a ref that may since have moved.
BRAIN_GO_SHA="$(git -C "$BRAIN_GO_DIR" rev-parse HEAD 2>/dev/null || echo unknown)"
echo "[bootstrap] brain-go ref ${brain_go_ref} -> $BRAIN_GO_SHA"


# The benchmark never opens the dashboard, but brain-go cannot start without
# the checkout present: dev-env.sh gates on it as a sibling of brain-go
# ("$MAIN_ROOT/../dashboard") and exits 1 when it is missing, and
# docker-compose.yml's dashboard service bind-mounts ../dashboard into the
# container. So `make up` fails on a box that does not have it. Cloned only to
# satisfy that. The service it feeds costs a pnpm install we get no value
# from, but it starts after api and chat are healthy and nothing below waits
# on it.
DASHBOARD_DIR="$(dirname "$BRAIN_GO_DIR")/dashboard"
if [ ! -d "$DASHBOARD_DIR" ]; then
  git clone --depth 1 \
    "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/dashboard.git" "$DASHBOARD_DIR" \
    || { terminate "could not clone dashboard"; exit 1; }
fi

# One brain-go stack per instance, shared by every slot on it: the compose
# stack (postgres, temporal, api, chat, tworker) is the expensive part and it
# is multi-tenant already. Slot 0 brings it up via setup_brain_go.sh, which
# also seeds slot 0's own tenant; each additional slot seeds only its own
# tenant against the running stack via seed_slot.sh. What must NOT be shared
# is the tenant: one account per concurrent run, or two slots investigating
# different problems would see each other's connections and entity graph and
# the results would be quietly wrong rather than obviously broken.
#
# AGENT_MODEL_ID and the region are passed here rather than relying on the
# exports further down (AGENT_MODEL_ID, AWS_DEFAULT_REGION): this call runs
# before that export block, and setup_brain_go.sh requires AGENT_MODEL_ID to
# be set already.
# brain-go's image build fetches the private nofire-code-miner module, and it
# needs both of the following on a box like this one. See NOFireAI/brain-go#2354.
#
# 1. A keyless ssh-agent. deploy/docker-compose.yml's build block declares
#    `ssh: [default]`, which compose resolves before any Dockerfile step runs.
#    With no agent at all it fails there, whatever credential you supplied:
#      failed to convert agent config {default [] false}:
#      invalid empty ssh agent socket: make sure SSH_AUTH_SOCK is set
#    An agent holding zero keys satisfies that check and is then never used,
#    because the build prefers the token below. There is no key to give it:
#    the instance role can read exactly one SSM parameter, the clone token.
#
# 2. MINER_REPO_PULL_TOKEN, the credential the build actually uses. Same token
#    already fetched above for the clones, which has read access to the module.
#    Deliberately not named GITHUB_TOKEN: that name is repo-scoped in most
#    tooling and would 403 against nofireai/nofire-code-miner.
eval "$(ssh-agent -s)" >/dev/null || { terminate "could not start an ssh-agent"; exit 1; }

# BRAIN_GO_CUSTOMER is deliberately not set, so setup_brain_go.sh keeps its own
# default and `make up` seeds a tenant no slot will ever ask for.
#
# It used to be "sregym-shard-$SHARD_INDEX-slot-0", from when that script also
# seeded slot 0's tenant. It has not done that since seeding moved per slot, and
# leaving the name behind actively broke slot 0: `make up` seeded that customer
# with dev-env's own token, then seed_slot.sh minted a fresh token for the same
# customer. devseed keys on a fixed api_keys.name and EnsureAPIKey is ON
# CONFLICT DO NOTHING, so the first hash stayed and the new token could never
# authenticate. brain-go said exactly that, and the run carried on regardless:
#
#   warning: the stored dev-stack api key does not match DEV_API_KEY
#   ...
#   TurnFailed: POST /cli/chat returned 401: invalid or expired API token
#
# Slots 1 and 2 were unaffected, because their customers were new and their keys
# were created rather than conflicting.

# Tuning knobs from the run's configuration (terraform local.brain_env), one
# KEY=VALUE per line. A quoted heredoc, so nothing here is expanded by this
# shell: the values are written into brain-go's .env verbatim.
BRAIN_ENV_EXTRA=$(cat <<'SREGYM_BRAIN_ENV'
${brain_env}
SREGYM_BRAIN_ENV
)

BRAIN_GO_DIR="$BRAIN_GO_DIR" \
SREGYM_MCP_PORT="9954" \
AGENT_MODEL_ID="${agent_model}" \
AWS_DEFAULT_REGION="${region}" \
MINER_REPO_PULL_TOKEN="$GH_TOKEN" \
BRAIN_ENV_EXTRA="$BRAIN_ENV_EXTRA" \
  "$WORKDIR/scripts/benchmark/setup_brain_go.sh" || { terminate "brain-go setup failed"; exit 1; }

# What produced these numbers, as one object beside the logs. See the script
# for why values and not just key names.
RUN_ID="$RUN_ID" SHARD_INDEX="$SHARD_INDEX" SHARD_COUNT="$SHARD_COUNT" \
PROBLEM_SET="${problem_set}" N_ATTEMPTS="${n_attempts}" NOISE="${noise}" \
PROBLEMS_OVERRIDE="${problems}" \
AGENT_TIMEOUT_SECONDS="${agent_timeout_seconds}" RUNS_PER_INSTANCE="${runs_per_instance}" \
AGENT_MODEL="${agent_model}" JUDGE_MODEL="${judge_model}" \
SREGYM_REF="${sregym_ref}" SREGYM_SHA="$(git -C "$WORKDIR" rev-parse HEAD 2>/dev/null || echo unknown)" \
BRAIN_GO_REF="${brain_go_ref}" BRAIN_GO_SHA="$BRAIN_GO_SHA" \
BRAIN_ENV_EXTRA="$BRAIN_ENV_EXTRA" \
  "$WORKDIR/scripts/benchmark/write_run_manifest.sh" "$MANIFEST" || true
# No upload here. sync_logs ships it on the next pass and on every pass after,
# which a single cp at boot does not: this runs seconds after the instance
# comes up, and a `|| true` on a transient S3 failure at that moment would
# leave the run with no record of its own configuration and no second chance.

# setup_brain_go.sh writes BRAIN_API_URL here. No key: every slot mints its own
# when it seeds its own tenant, slot 0 included.
# shellcheck disable=SC1091
. /etc/profile.d/sregym-brain-go.sh
# --- shard runner -----------------------------------------------------------
# Everything past this point lives in the repo, not in user_data. EC2 caps user
# data at 16384 bytes and the port-forward supervisor plus the resume merge went
# 588 bytes over it. Neither change alone did, which is why nothing caught it
# until they met. scripts/benchmark/measure_user_data.py is the check.
#
# Sourced, not executed: the block uses terminate, hard_stop, sync_results and
# sync_logs, and the traps and background watchdogs already armed above. A child
# process would inherit none of them.
#
# The values below were template interpolations. run_shard.sh is a repo file
# cannot interpolate, so they are passed as shell variables.
PROBLEM_SET="${problem_set}"
PROBLEMS_OVERRIDE="${problems}"
N_ATTEMPTS="${n_attempts}"
AGENT_TIMEOUT_SECONDS="${agent_timeout_seconds}"
RUNS_PER_INSTANCE="${runs_per_instance}"
AGENT_MODEL="${agent_model}"
JUDGE_MODEL="${judge_model}"
SREGYM_REF="${sregym_ref}"
NOISE="${noise}"
export PROBLEM_SET PROBLEMS_OVERRIDE N_ATTEMPTS AGENT_TIMEOUT_SECONDS RUNS_PER_INSTANCE
export AGENT_MODEL JUDGE_MODEL SREGYM_REF NOISE

# Hard failure, not a warning. Without this file the instance completes its
# bootstrap, runs nothing, and terminates looking like a clean short run.
if [ ! -f "$WORKDIR/scripts/benchmark/run_shard.sh" ]; then
  terminate "scripts/benchmark/run_shard.sh missing on ref ${sregym_ref}"
  exit 1
fi
# shellcheck disable=SC1091
. "$WORKDIR/scripts/benchmark/run_shard.sh"
