#!/usr/bin/env bash
# SREGym benchmark shard bootstrap. Rendered by terraform/compute.tf.
#
# Lifecycle: install -> pull prior results -> run this shard with --resume ->
# sync after every problem -> terminate.
#
# Terminating is the normal exit, not the error path. A forgotten r7a.24xlarge
# costs about $7.30/hr on demand, so the instance kills itself when its shard is
# done and again when max_runtime_hours elapses, whichever comes first.

set -uo pipefail
exec > >(tee -a /var/log/sregym-bootstrap.log) 2>&1

RUN_ID="${run_id}"
SHARD_INDEX="${shard_index}"
SHARD_COUNT="${shard_count}"
REGION="${region}"
BUCKET="${bucket}"
S3_PREFIX="s3://${bucket}/${run_id}/shard-${shard_index}"
WORKDIR=/opt/sregym
# Each slot writes its own results tree at slots/<slot>/results (main.py
# resolves "results" relative to the slot's own working directory -- see the
# slot-workers section below). Syncing the whole slots/ tree in one call is
# simpler and correct where a per-slot sync would just be this in a loop:
# S3 sync only transfers what changed, so one call covers every slot's
# progress without knowing how many there are.
SLOTS_DIR="$WORKDIR/slots"

echo "[bootstrap] run=$RUN_ID shard=$SHARD_INDEX/$SHARD_COUNT region=$REGION"
echo "[bootstrap] results -> $S3_PREFIX"

IID=$(curl -sf -H "X-aws-ec2-metadata-token: $(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 21600')" \
      http://169.254.169.254/latest/meta-data/instance-id)
echo "[bootstrap] instance=$IID"

terminate() {
  local reason="$1"
  echo "[bootstrap] terminating: $reason"
  sync_results || true
  sync_logs || true
  %{ if keep_alive_on_failure }
  echo "[bootstrap] keep_alive_on_failure is set, staying up. hard_stop still terminates at the runtime cap."
  %{ else }
  aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || shutdown -h now
  %{ endif }
}

# Unconditional kill, used only by the runtime cap below. keep_alive_on_failure
# deliberately does not apply here: the cap exists so a wedged or forgotten run
# cannot bill indefinitely, and a debug flag that silently disables the one
# backstop against that defeats its purpose. Every other exit goes through
# terminate() above, which the flag does suppress.
hard_stop() {
  echo "[bootstrap] $1"
  sync_results || true
  sync_logs || true
  aws ec2 terminate-instances --region "$REGION" --instance-ids "$IID" || shutdown -h now
}

sync_results() {
  [ -d "$SLOTS_DIR" ] || return 0
  aws s3 sync "$SLOTS_DIR" "$S3_PREFIX/slots/" --region "$REGION" --only-show-errors
}

# The bootstrap log and the per-slot logs live in /var/log, outside SLOTS_DIR,
# so sync_results never carried them. Without this a self-terminating failure
# takes the only record of why it failed down with the instance, which leaves
# keep_alive_on_failure as the only way to debug one and that bills per hour
# until someone remembers to kill the box.
sync_logs() {
  for f in /var/log/sregym-bootstrap.log /var/log/sregym-slot-*.log; do
    [ -f "$f" ] || continue
    aws s3 cp "$f" "$S3_PREFIX/logs/$(basename "$f")" \
      --region "$REGION" --only-show-errors || true
  done
}

# --- hard runtime cap -------------------------------------------------------
# Backstop against a wedged run. The normal exit is shard completion below.
( sleep $(( ${max_runtime_hours} * 3600 )) && hard_stop "max_runtime_hours=${max_runtime_hours} elapsed" ) &

# --- spot interruption ------------------------------------------------------
# EC2 gives two minutes' notice on IMDS. With per-problem syncing this is belt
# and braces, but it costs ten lines and saves the in-flight problem's partial
# artifacts.
(
  while true; do
    TOKEN=$(curl -sf -X PUT http://169.254.169.254/latest/api/token -H 'X-aws-ec2-metadata-token-ttl-seconds: 60' || true)
    if [ -n "$TOKEN" ] && curl -sf -H "X-aws-ec2-metadata-token: $TOKEN" \
         http://169.254.169.254/latest/meta-data/spot/instance-action >/dev/null 2>&1; then
      echo "[spot] interruption notice received, syncing before we lose the box"
      sync_results || true
      sync_logs || true
      exit 0
    fi
    sleep 5
  done
) &

# --- host prerequisites -----------------------------------------------------
# kind nodes share the host's inotify limits, and the defaults are low enough
# that system pods die with "too many open files" once several clusters are up.
cat >/etc/sysctl.d/99-sregym.conf <<'SYSCTL'
fs.inotify.max_user_instances=1024
fs.inotify.max_user_watches=1048576
fs.file-max=2097152
SYSCTL
sysctl --system

export DEBIAN_FRONTEND=noninteractive
apt-get update -y
# openssh-client is listed explicitly for ssh-agent, not for ssh. The brain-go
# image build needs a keyless agent running before compose will resolve its
# build config at all (see the brain-go section below). Ubuntu's server image
# ships it, but naming it here means a base-image change cannot quietly remove
# the one binary that gates the build.
apt-get install -y ca-certificates curl gnupg git jq unzip make openssh-client

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg
echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" \
  >/etc/apt/sources.list.d/docker.list
apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
systemctl enable --now docker

curl -fsSL -o /usr/local/bin/kind https://kind.sigs.k8s.io/dl/latest/kind-linux-amd64
chmod +x /usr/local/bin/kind
curl -fsSL -o /usr/local/bin/kubectl "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
chmod +x /usr/local/bin/kubectl
curl -fsSL https://raw.githubusercontent.com/helm/helm/main/scripts/get-helm-3 | bash
curl -fsSL https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh

curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o /tmp/awscliv2.zip
unzip -q /tmp/awscliv2.zip -d /tmp && /tmp/aws/install --update

# --- the harness ------------------------------------------------------------
GH_TOKEN=$(aws ssm get-parameter --region "$REGION" --name "${github_token_ssm_path}" --with-decryption --query 'Parameter.Value' --output text)
if [ -z "$GH_TOKEN" ] || [ "$GH_TOKEN" = "None" ]; then
  terminate "could not read the clone token from ${github_token_ssm_path}"
  exit 1
fi

git clone --recurse-submodules "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/sregym.git" "$WORKDIR"
cd "$WORKDIR"
git checkout "${sregym_ref}"
uv sync

# --- brain-go ---------------------------------------------------------------
# BRAIN_API_URL defaults to localhost:8001, so brain-go runs here beside the
# harness. Standing it up, seeding the account and the four CUSTOM_MCP rows, and
# minting the CLI key is NOFireAI/brain-go#2219's job. Until that lands this
# shard cannot run, so fail loudly rather than burning an hour looking healthy.
if [ ! -x "$WORKDIR/scripts/benchmark/setup_brain_go.sh" ]; then
  echo "[bootstrap] scripts/benchmark/setup_brain_go.sh is missing on ref ${sregym_ref}."
  terminate "brain-go setup script not present"
  exit 1
fi

# brain-go runs on this box beside the harness, so it has to be checked out
# here. setup_brain_go.sh brings up its compose stack and seeds it.
BRAIN_GO_DIR=/opt/brain-go
if [ ! -d "$BRAIN_GO_DIR" ]; then
  git clone --depth 1 --branch "${brain_go_ref}" \
    "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/brain-go.git" "$BRAIN_GO_DIR" \
    || { terminate "could not clone brain-go"; exit 1; }
fi

# The benchmark never opens the dashboard, but brain-go cannot start without
# the checkout present: dev-env.sh gates on it as a sibling of brain-go
# ("$MAIN_ROOT/../dashboard") and exits 1 when it is missing, and
# docker-compose.yml's dashboard service bind-mounts ../dashboard into the
# container. So `make up` fails on a box that does not have it. Cloned only to
# satisfy that. The service it feeds costs a pnpm install we get no value
# from, but it starts after api and chat are healthy and nothing below waits
# on it.
DASHBOARD_DIR="$(dirname "$BRAIN_GO_DIR")/dashboard"
if [ ! -d "$DASHBOARD_DIR" ]; then
  git clone --depth 1 \
    "https://x-access-token:$GH_TOKEN@github.com/NOFireAI/dashboard.git" "$DASHBOARD_DIR" \
    || { terminate "could not clone dashboard"; exit 1; }
fi

# One brain-go stack per instance, shared by every slot on it: the compose
# stack (postgres, temporal, api, chat, tworker) is the expensive part and it
# is multi-tenant already. Slot 0 brings it up via setup_brain_go.sh, which
# also seeds slot 0's own tenant; each additional slot seeds only its own
# tenant against the running stack via seed_slot.sh. What must NOT be shared
# is the tenant: one account per concurrent run, or two slots investigating
# different problems would see each other's connections and entity graph and
# the results would be quietly wrong rather than obviously broken.
#
# AGENT_MODEL_ID and the region are passed here rather than relying on the
# exports further down (AGENT_MODEL_ID, AWS_DEFAULT_REGION): this call runs
# before that export block, and setup_brain_go.sh requires AGENT_MODEL_ID to
# be set already.
# brain-go's image build fetches the private nofire-code-miner module, and it
# needs both of the following on a box like this one. See NOFireAI/brain-go#2354.
#
# 1. A keyless ssh-agent. deploy/docker-compose.yml's build block declares
#    `ssh: [default]`, which compose resolves before any Dockerfile step runs.
#    With no agent at all it fails there, whatever credential you supplied:
#      failed to convert agent config {default [] false}:
#      invalid empty ssh agent socket: make sure SSH_AUTH_SOCK is set
#    An agent holding zero keys satisfies that check and is then never used,
#    because the build prefers the token below. There is no key to give it:
#    the instance role can read exactly one SSM parameter, the clone token.
#
# 2. MINER_REPO_PULL_TOKEN, the credential the build actually uses. Same token
#    already fetched above for the clones, which has read access to the module.
#    Deliberately not named GITHUB_TOKEN: that name is repo-scoped in most
#    tooling and would 403 against nofireai/nofire-code-miner.
eval "$(ssh-agent -s)" >/dev/null || { terminate "could not start an ssh-agent"; exit 1; }

BRAIN_GO_DIR="$BRAIN_GO_DIR" \
BRAIN_GO_CUSTOMER="sregym-shard-$SHARD_INDEX-slot-0" \
SREGYM_MCP_PORT="9954" \
AGENT_MODEL_ID="${agent_model}" \
AWS_DEFAULT_REGION="${region}" \
MINER_REPO_PULL_TOKEN="$GH_TOKEN" \
  "$WORKDIR/scripts/benchmark/setup_brain_go.sh" || { terminate "brain-go setup failed"; exit 1; }

# setup_brain_go.sh writes BRAIN_API_URL here. No key: every slot mints its own
# when it seeds its own tenant, slot 0 included.
# shellcheck disable=SC1091
. /etc/profile.d/sregym-brain-go.sh

# --- resume -----------------------------------------------------------------
# Pull whatever this shard already finished, for every slot at once: slot
# assignment below is deterministic (same sorted problem list, same fixed
# runs_per_instance), so a replacement instance redivides problems into the
# same slots as before it died -- one sync call up front is simpler than N,
# and S3 sync only transfers what changed either way. main.py --resume counts
# attempts per problem_id and skips any problem that already has n_attempts
# rows, so a replacement instance costs the in-flight problem and nothing more.
mkdir -p "$SLOTS_DIR"
aws s3 sync "$S3_PREFIX/slots/" "$SLOTS_DIR" --region "$REGION" --only-show-errors || true

# --- shard ------------------------------------------------------------------
# Static sharding: problem index % shard_count. No queue and no coordinator,
# which is the right trade for 90 to 540 runs where the only failure mode that
# matters is instance death, and S3 resume already covers that.
# problem_sets.py is pure data. The registry is not: ProblemRegistry() loads a
# kubeconfig on construction, and at this point the cluster may not exist yet.
# The full-suite path is blocked on NOFireAI/brain-go#2221 anyway, which has to
# reconstruct which 90 of the 137 registered problems the paper used.
if [ -z "${problem_set}" ]; then
  echo "[bootstrap] problem_set is empty, which means the full registry."
  echo "[bootstrap] That set is undefined: 137 problems are registered, the paper"
  echo "[bootstrap] used 90, and nothing in the repo says which. See NOFireAI/brain-go#2221."
  terminate "full-suite runs need a defined problem set"
  exit 1
fi

PROBLEMS=$(uv run python -c "
from sregym.conductor.problem_sets import PROBLEM_SETS
ids = sorted(PROBLEM_SETS['${problem_set}'])
print(' '.join(p for i, p in enumerate(ids) if i % $SHARD_COUNT == $SHARD_INDEX))
")

if [ -z "$PROBLEMS" ]; then
  terminate "shard $SHARD_INDEX resolved to no problems"
  exit 0
fi
echo "[bootstrap] shard $SHARD_INDEX owns $(echo $PROBLEMS | wc -w) problems"

# --- run --------------------------------------------------------------------
export AGENT_MODEL_ID="${agent_model}"
export JUDGE_MODEL_ID="${judge_model}"
export AWS_DEFAULT_REGION="$REGION"

# Every SREGYM_* intervention stays off. They exist to work around a 24 GB ARM
# laptop and they are why engineering#799's numbers cannot be read. SETTLE_SECONDS
# defaults to 180, so leaving it unset is not the same as turning it off.
export SREGYM_SETTLE_SECONDS=0
unset SREGYM_WAIT_FAULT_EVENT SREGYM_WAIT_EDGE_SYNC SREGYM_STELLARIZE \
      SREGYM_STABILIZE_PODS SREGYM_GATE_SKIP SREGYM_BASELINE_SYNC_SECONDS \
      SREGYM_SKIP_JUDGE_PREFLIGHT

# Sync after every problem rather than at the end, so an interruption costs one
# problem. The watcher is cheap and independent of the run's own exit path.
#
# Logs go up on the same tick, not only on exit. Syncing them only from
# terminate() means any death that skips it -- a spot reclaim, a kernel OOM,
# a hard kill -- takes the whole diagnostic trail with it. Run
# run-20260828-2122 lost three hours that way: all three slots stopped
# progressing right after "Deploying Loki", the box was reclaimed before
# terminate() ran, and the only surviving record was helm's cache directory.
# The per-slot logs, which had whatever error followed, died with the box.
( while true; do sleep 60; sync_results || true; sync_logs || true; done ) &

NOISE_FLAG=""
%{ if noise }
NOISE_FLAG="--noise"
%{ endif }

RUNS_PER_INSTANCE=${runs_per_instance}

# --- slot workers -----------------------------------------------------------
# Each slot is one concurrent SREGym run on this instance, and needs four
# things kept to itself. run_slot_env.sh supplies the first three (its own kind
# cluster name, its own KUBECONFIG, its own cache dir, and the API/MCP/k8s-proxy
# host ports); the fourth is its brain-go tenant, seeded per slot below.
#
# A fifth is this function's own doing: main.py writes results to
# `Path("results")` relative to the *current directory*, and
# `results/traces.db` is shared by every run under one results tree. Two slots
# in one directory would interleave into the same tree and contend on that one
# SQLite file, so each slot runs with its own CWD and gets its own results tree.
# main.py resolves its own module paths absolutely, so running it by absolute
# path from elsewhere is safe (verified).
run_slot() {
  local slot="$1"
  shift
  local problems="$*"

  local slot_dir="$WORKDIR/slots/$slot"
  local slot_log="/var/log/sregym-slot-$slot.log"
  mkdir -p "$slot_dir"

  {
    echo "[slot $slot] starting with $(echo $problems | wc -w) problems"

    # Ports, cluster name, kubeconfig and cache dir for this slot.
    eval "$(SREGYM_SLOT_ROOT="$WORKDIR/slot-state" "$WORKDIR/scripts/benchmark/run_slot_env.sh" "$slot")"

    # Each slot needs its own kind cluster. Nothing else creates it: main.py
    # exits with "Missing kubeconfig. Please set up a cluster." if it is absent,
    # and the bootstrap installs kind without ever calling it.
    echo "[slot $slot] creating kind cluster $KIND_CLUSTER_NAME"
    if ! bash "$WORKDIR/kind/setup_kind_cluster.sh" x86; then
      echo "[slot $slot] cluster creation failed, slot aborted"
      return 1
    fi

    # Put an MCP server in the cluster before seeding. The conductor deploys one
    # itself, but from deploy_app(), which runs per problem inside
    # start_problem() -- too late, because seeding has to discover the tool
    # schemas from a live server first (brain-go does not populate tools_cache
    # itself). Deploying here is not duplicative: MCPServer.deploy() skips the
    # apply when the deployment is already ready and only revives a stale
    # port-forward, so the conductor's later call is a no-op.
    echo "[slot $slot] deploying the MCP server into $KIND_CLUSTER_NAME"
    if ! uv run --project "$WORKDIR" python "$WORKDIR/scripts/benchmark/deploy_mcp.py"; then
      echo "[slot $slot] MCP server deploy failed, slot aborted"
      return 1
    fi

    # The port-forward is ours, not the deploy script's. MCPServer starts one
    # as a subprocess.Popen child, which dies when that script exits, so the
    # script deliberately tears its own down and leaves this to us. Started
    # with nohup under this slot's subshell so it lives as long as the slot.
    #
    # Bound to 0.0.0.0 because brain-go dials it from inside a container, where
    # 127.0.0.1 is that container's own loopback: seed_slot.sh registers the
    # connections against the host's private address, not localhost.
    echo "[slot $slot] starting the MCP port-forward on $MCP_SERVER_PORT"
    nohup kubectl port-forward svc/mcp-server "$MCP_SERVER_PORT:9954" \
      -n sregym --address 0.0.0.0 >>"/var/log/sregym-pf-$slot.log" 2>&1 &
    PF_PID=$!

    # Confirm it is actually serving before handing off. Without this the slot
    # runs on to seed_slot.sh, which waits 300s on an endpoint that will never
    # answer and then aborts, which is precisely how the previous run failed.
    pf_ok=0
    pf_deadline=$(( $(date +%s) + 60 ))
    while [ "$(date +%s)" -lt "$pf_deadline" ]; do
      if [ "$(curl -s -o /dev/null -w '%%{http_code}' --max-time 5 \
              "http://127.0.0.1:$MCP_SERVER_PORT/kubectl/sse" 2>/dev/null)" = "200" ]; then
        pf_ok=1
        break
      fi
      kill -0 "$PF_PID" 2>/dev/null || break
      sleep 2
    done
    if [ "$pf_ok" != "1" ]; then
      echo "[slot $slot] MCP port-forward never served on $MCP_SERVER_PORT, slot aborted"
      kill "$PF_PID" 2>/dev/null || true
      return 1
    fi
    echo "[slot $slot] MCP port-forward serving on $MCP_SERVER_PORT (pid $PF_PID)"

    # Every slot seeds its own tenant, slot 0 included. It used to be special,
    # seeded by setup_brain_go.sh while that script brought the shared stack up,
    # but that ran before any cluster existed and so before any MCP server did:
    # the connection registration inside it could never succeed on a fresh box.
    #
    # The api URL is passed explicitly. Without it seed_slot.sh falls back to
    # $BRAIN_API_URL, which the profile file sourced above sets to the CHAT
    # service (8001) because that is what the driver talks to. Connections are
    # an api-service concern: POST /api/connections lives there, and so does
    # the csrfCookie middleware. Chat answers GET /health with a 200 and no
    # CSRF-TOKEN, so seeding failed with a message that pointed at cookies
    # rather than at the wrong port:
    #   no CSRF-TOKEN cookie in the /health response (200)
    echo "[slot $slot] seeding its own brain-go tenant"
    if ! eval "$(BRAIN_GO_DIR="$BRAIN_GO_DIR" "$WORKDIR/scripts/benchmark/seed_slot.sh" \
           "sregym-shard-$SHARD_INDEX-slot-$slot" "$MCP_SERVER_PORT" \
           "http://127.0.0.1:8000")"; then
      echo "[slot $slot] tenant seeding failed, slot aborted"
      return 1
    fi

    cd "$slot_dir" || return 1

    # This slot's own prior results, pulled above as part of the whole
    # slots/ tree. Each slot resumes from its own CSV, not a shared one --
    # results is a name reused per slot working directory, not one file.
    local resume_csv resume_arg
    resume_csv=$(find "$slot_dir/results" -name '*_ALL_results.csv' -print -quit 2>/dev/null || true)
    resume_arg=""
    if [ -n "$resume_csv" ]; then
      echo "[slot $slot] resuming from $resume_csv ($(wc -l <"$resume_csv") rows)"
      resume_arg="--resume $resume_csv"
    else
      echo "[slot $slot] no prior results, starting clean"
    fi

    for pid in $problems; do
      echo "[slot $slot] === $pid ==="
      uv run --project "$WORKDIR" python "$WORKDIR/main.py" \
        --agent brain_go \
        --problem "$pid" \
        --model "${agent_model}" \
        --judge-model "${judge_model}" \
        --n-attempts ${n_attempts} \
        --agent-timeout ${agent_timeout_seconds} \
        $NOISE_FLAG $resume_arg || echo "[slot $slot] $pid failed, continuing"
      sync_results || true
    done

    echo "[slot $slot] complete"
  } >>"$slot_log" 2>&1
}

# Split this shard's problems across the slots the same way the shard itself
# was split across instances: static, index-based, no coordinator. A slot that
# draws no problems simply never starts.
SLOT_PIDS=""
for slot in $(seq 0 $(( RUNS_PER_INSTANCE - 1 ))); do
  slot_problems=""
  i=0
  for pid in $PROBLEMS; do
    if [ $(( i % RUNS_PER_INSTANCE )) -eq "$slot" ]; then
      slot_problems="$slot_problems $pid"
    fi
    i=$(( i + 1 ))
  done

  if [ -z "$slot_problems" ]; then
    echo "[bootstrap] slot $slot drew no problems, skipping"
    continue
  fi

  run_slot "$slot" $slot_problems &
  SLOT_PIDS="$SLOT_PIDS $!"
done

# Wait on the slots by pid rather than a bare `wait`, which would also wait on
# the sync watcher and the runtime-cap timer and never return.
for p in $SLOT_PIDS; do
  wait "$p" || echo "[bootstrap] a slot exited non-zero"
done

echo "[bootstrap] shard $SHARD_INDEX complete (all $RUNS_PER_INSTANCE slots)"
terminate "shard complete"
